# Hugging Face token: required only for gated SraVaani / Indic-Transcribe model access
HF_TOKEN=

# Optional hosted Sarvam Speech-to-Text API (metered)
SARVAM_API_KEY=

# Optional local model configuration
INDICCONFORMER_CHECKPOINT=
INDICCONFORMER_DEVICE=cpu
INDIC_TRANSCRIBE_MODEL=bodhan-ai/indic-transcribe-core
INDIC_TRANSCRIBE_DEVICE=cpu
SRAVAANI_DEVICE=cpu
